# Meta app (https://developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change-me
GRAPH_API_VERSION=v21.0

# Instagram Login: paste the Instagram user access token from Add account.
# (Variable name is historical; this app reads it as the brand token.)
GRAPH_API_HOST=https://graph.instagram.com
INSTAGRAM_APP_SECRET=
BRAND_ACME_PAGE_TOKEN=
BRAND_STUDIO_PAGE_TOKEN=

# Protects /api/* (schedule posts, inspect brands). Webhooks stay public + HMAC-verified.
API_KEY=change-me

# Public base URL Meta can reach (ngrok/cloudflare tunnel in local dev)
PUBLIC_BASE_URL=https://your-tunnel.example.com

HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite:///./data/app.db
