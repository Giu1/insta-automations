# Copy this file to ".env" and fill in the values. Never share or commit ".env".

# Meta App Dashboard -> Instagram -> API setup with Instagram login -> "Instagram app secret" (click Show)
INSTAGRAM_APP_SECRET=

# Any word you choose. Type the same word in the Meta webhook "Verify token" box.
WEBHOOK_VERIFY_TOKEN=change-me

# One line per brand (name must match token_env in config/brands.yaml).
# Meta App Dashboard -> Instagram -> API setup with Instagram login -> Generate token
BRAND_MARKETERMILANO_TOKEN=

# Optional
# LOG_LEVEL=INFO
# DATABASE_URL=sqlite:///./data/app.db
